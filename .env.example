POSTGRES_USER=lakehouse_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lakehouse

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=energy-lakehouse

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_FIRSTNAME=TFM
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@localhost

SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_ADMIN_FIRSTNAME=TFM
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@localhost
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret-key

# External APIs
AEMET_API_KEY=
ESIOS_API_KEY=

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=energy-lakehouse
MINIO_SECURE=false

# HTTP configuration
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3

# Historical ingestion chunk sizes (days)
AEMET_HISTORICAL_CHUNK_DAYS=31
OPEN_METEO_HISTORICAL_CHUNK_DAYS=31
ESIOS_HISTORICAL_CHUNK_DAYS=31